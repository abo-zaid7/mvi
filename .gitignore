# Virtual environments.  Two of them, deliberately kept apart: Task 1 must not have
# TensorFlow available, and Task 2 needs it.  Both are rebuilt from the requirements
# files rather than committed.
mvi-env/
tf-env/

# The dataset.  BRISC 2025 is downloaded from Kaggle, not redistributed here.
brisc2025/

# Trained model binaries.  Large, and regenerated by task1/train_model.py and
# task2/run_all.py.  The GUI needs them present to run - see task3/README.md.
*.joblib
*.h5

# Scans uploaded through the GUI at run time.
task3/uploads/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# macOS
.DS_Store

# Per-machine Claude Code settings, not part of the assignment.
.claude/settings.local.json

# ---------------------------------------------------------------- group work
# Afnan's folder arrived with her own environment, her copy of the dataset and
# about thirty Keras checkpoints.  None of the three belongs in the repository:
# the environment is rebuilt from requirements, BUSI is a Kaggle download that
# is not ours to redistribute, and GitHub refuses any single file over 100 MB.
afnan/.venv/
afnan/Dataset_BUSI_with_GT/
afnan/*.keras
afnan/*.keras.gz

# Aman's share folders DO go in - the recorded results are what let the GUI run
# his two models on a fresh clone, and they are small enough to live in git.

# The previous assignment, kept locally as a writing reference.  It is personal
# work from another module and not part of this submission.
previous assignment.docx
~$evious assignment.docx

# Word's lock files, created while a document is open.
~$*
